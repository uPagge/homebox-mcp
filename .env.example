# Copy to .env (gitignored, chmod 600) and fill in.
#
# Create an API key in Homebox: Profile → API Keys, or
#   POST /api/v1/users/self/api-keys  {"name": "homebox-mcp"}

# Base URL of your Homebox instance (no trailing slash).
HOMEBOX_URL=http://localhost:7745

# Homebox API key (starts with hb_).
HOMEBOX_TOKEN=hb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private HTTP only: generate independent random MCP credentials (>=32 ASCII chars).
# Never reuse HOMEBOX_TOKEN here. Keep this file out of version control.
#HOMEBOX_MCP_TOKEN=replace-with-independent-random-edit-key
#HOMEBOX_MCP_READ_TOKEN=replace-with-different-random-read-key
#HOMEBOX_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
#HOMEBOX_MCP_ALLOWED_ORIGINS=

# OAuth resource mode uses an external issuer and its trusted PUBLIC RSA PEM.
#HOMEBOX_MCP_OAUTH_ISSUER=https://issuer.example
#HOMEBOX_MCP_OAUTH_RESOURCE=https://mcp.example/mcp
#HOMEBOX_MCP_OAUTH_PUBLIC_KEY_FILE=/configured/path/public.pem

# --- Optional -------------------------------------------------------------

# Trusted Homebox attachment search endpoint. It receives the Homebox API key.
#HOMEBOX_ATTACHMENT_SEARCH_URL=https://homebox.example.com/attachment-search

# Name of one custom field used as a stable item identifier: tools resolve
# items by it and field_index() defaults to it. Unset = resolve by
# assetId/name only.
#HOMEBOX_ALIAS_FIELD=item_id

# Directory where generate_label / qrcode save PNG/JPEG output.
# Default: current working directory.
#HOMEBOX_LABEL_DIR=~/homebox-labels
